---
import Navbar from '@/components/Navbar.astro';
import SlideCard from '@/components/SlideCard.astro';
import ThemeToggle from '@/components/ThemeToggle.svelte';
import { SITE_NAME, navLinks } from '@/consts';
import BaseLayout from '@/layouts/BaseLayout.astro';
import type { Slide } from '@/types';

export interface Props {
  /** Page/section heading. */
  title: string;
  /** Optional intro text under the heading. */
  description?: string;
  /** Optional small label above the heading. */
  eyebrow?: string;
  /** Deck cards rendered in a responsive grid. */
  slides: Slide[];
}

const { title, description, eyebrow, slides } = Astro.props;
---

<BaseLayout title={`${title} — ${SITE_NAME}`} description={description}>
  <Navbar slot="header" siteName={SITE_NAME} links={navLinks}>
    <ThemeToggle client:load />
  </Navbar>

  <section class="mx-auto max-w-6xl px-6 py-12">
    <header class="mb-10">
      {eyebrow && (
        <p class="mb-2 text-sm font-semibold uppercase tracking-wide text-accent">{eyebrow}</p>
      )}
      <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl">{title}</h1>
      {description && <p class="mt-3 max-w-2xl text-lg text-text-secondary">{description}</p>}
    </header>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {slides.map((slide) => <SlideCard {...slide} />)}
    </div>

    <slot />
  </section>

  <footer slot="footer" class="border-t border-border px-6 py-8 text-center text-sm text-text-secondary">
    <p>&copy; {new Date().getFullYear()} {SITE_NAME}.</p>
  </footer>
</BaseLayout>

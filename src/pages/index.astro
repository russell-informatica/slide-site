---
import Card from '@/components/Card.astro';
import { SECTIONS, SITE_DESCRIPTION, SITE_NAME } from '@/consts';
import PageLayout from '@/layouts/PageLayout.astro';
import { withBase } from '@/utils/base';

const siteName = SITE_NAME;
---

<PageLayout title="Sezioni" documentTitle={siteName} description={SITE_DESCRIPTION}>
  <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {SECTIONS.map((section) => (
      <Card href={withBase(`/${section.slug}`)}>
        <h2 class="mb-2 text-xl font-bold">{section.label}</h2>
        <p class="leading-relaxed text-text-secondary">Slide e materiali per {section.label}.</p>
      </Card>
    ))}
  </div>
</PageLayout>

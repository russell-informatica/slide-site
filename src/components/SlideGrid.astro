---
import type { Slide } from '../types';
import { cn } from '../utils/cn';
import SlideCard from './SlideCard.astro';

export interface Props {
  /** Deck cards to render in a responsive grid. */
  slides: Slide[];
  /** Extra classes for the grid (e.g. to change columns or spacing). */
  class?: string;
}

const { slides, class: className } = Astro.props;
---

<div class={cn('grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3', className)}>
  {slides.map((slide) => <SlideCard {...slide} />)}
</div>

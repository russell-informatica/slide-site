---
import type { Slide } from '../types';
import { cn } from '../utils/cn';
import SlideCard from './SlideCard.astro';

export interface Props {
  /** Deck cards to render. They grow to fill each row and wrap as needed. */
  slides: Slide[];
  /** Extra classes for the flex container (e.g. to change gap or min width). */
  class?: string;
}

const { slides, class: className } = Astro.props;
---

<div class={cn('flex flex-wrap gap-6', className)}>
  {slides.map((slide) => (
    <SlideCard
      {...slide}
      class="min-w-[min(100%,17rem)] grow basis-[17rem]"
    />
  ))}
</div>

---
import { cn } from '../utils/cn';

export interface Props {
  /** Optional centered label, doubling as a group heading. */
  label?: string;
  /** Extra classes for the divider. */
  class?: string;
}

const { label, class: className } = Astro.props;
---

<div class={cn('my-10 flex items-center gap-4', className)} role="separator">
  <span class="h-px flex-1 bg-border"></span>
  {label && (
    <span class="text-sm font-semibold uppercase tracking-wide text-text-secondary">{label}</span>
  )}
  <span class="h-px flex-1 bg-border"></span>
</div>
